{
  "version": "2.0",
  "extensions": {
    "http": {
      "routePrefix": "api",
      "maxOutstandingRequests": 100,
      "maxConcurrentRequests": 50
    },
    "functions": {
      "functionTimeout": "00:10:00",
      "logging": {
        "logLevel": {
          "default": "Information",
          "Host.Results": "Warning",
          "Host.Aggregator": "Warning",
          "Function": "Information"
        }
      }
    }
  }
}